{
  "rules": {
    "quiz": {
      "state": {
        ".read": "auth != null",
        ".write": "auth != null"
      },
      "live": {
        ".read": true,
        ".write": "auth != null"
      },
      "answers": {
        ".read": true,
        ".write": "auth != null",
        "$qid": { "$team": { ".write": true } }
      }
    },
    "teams": { ".read": true, ".write": true },
    "pins": {
      ".read": "auth != null",
      ".write": "auth != null",
      "$team": {
        ".write": "!data.exists()",
        "$pin": {
          ".read": true,
          ".validate": "$pin.matches(/^[0-9]{4}$/)"
        }
      }
    },
    "session": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}
